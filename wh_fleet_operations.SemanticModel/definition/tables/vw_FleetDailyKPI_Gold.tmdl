table vw_FleetDailyKPI_Gold
	lineageTag: 919d9441-5b1c-49db-aee1-05c01e98bebb

	measure 'Weighted Average ETA (Seconds)' =
			
			DIVIDE(
			    SUMX(
			        vw_FleetDailyKPI_Gold,
			        vw_FleetDailyKPI_Gold[AverageETASeconds] * vw_FleetDailyKPI_Gold[UniquePayloadRows]
			    ),
			    SUM(vw_FleetDailyKPI_Gold[UniquePayloadRows]),
			    0
			)
		lineageTag: 9ac34b88-1d6f-4edd-8617-448c816b69c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unique Payload Rows' = SUM(vw_FleetDailyKPI_Gold[UniquePayloadRows])
		formatString: 0
		lineageTag: 4b7da505-6612-4c96-bb2d-ddb08b9354ad

	measure 'Source Rows Received' = SUM(vw_FleetDailyKPI_Gold[SourceRowsReceived])
		formatString: 0
		lineageTag: c75e3a00-7c05-4309-8ae2-9d90ba9204c9

	measure 'Exact-Payload Excess Rows' = SUM(vw_FleetDailyKPI_Gold[DuplicateExcessRows])
		formatString: 0
		lineageTag: 5bd3c6dc-922e-4990-9aab-800f6393f0bd

	measure 'Bus Lines Covered' = DISTINCTCOUNT(vw_FleetDailyKPI_Gold[BusLineCode])
		formatString: 0
		lineageTag: aa6625e6-74e9-4fde-9fb1-6d6f32d70f40

